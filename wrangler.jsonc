{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amtsistemas",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "assets": {
    "directory": ".output/public"
  },
  "observability": {
    "enabled": true
  },
  // O deploy (push no main -> Cloudflare) não apaga as variáveis cadastradas no painel do Worker.
  // Segredos (SUPABASE_SERVICE_ROLE_KEY, OPTIONE_SITE_SECRET, ASAAS_API_KEY...) ficam SOMENTE no
  // painel, como tipo "Secret" — nunca neste arquivo, que é público.
  "keep_vars": true,
  // Valores públicos do Supabase do site (os mesmos do .env e do JavaScript do navegador),
  // lidos pelas funções de servidor via process.env.
  "vars": {
    "SUPABASE_URL": "https://yqxmxevphdumyuwlvppg.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_jK7lhco6DQLlfjYm8LGS3g_sGBkVtK2"
  }
}
